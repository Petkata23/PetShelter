@model PetShelter.ViewModels.LocationDetailsVM

@{
    ViewBag.Title = "Delete";
}

<div class="container mt-4">
    <h2 class="text-center">Delete Location</h2>
    <h3 class="text-center text-danger">Are you sure you want to delete this?</h3>
    <div class="card mt-4">
        <div class="card-body">
            <h4 class="card-title">Location Details</h4>
            <hr />
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.City)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.City)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Address)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Address)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Country)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Country)
                </dd>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-group text-center">
                    <input type="submit" value="Delete" class="btn btn-danger" />
                    <a href="@Url.Action("List")" class="btn btn-secondary">Back to List</a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Include Bootstrap CSS (if not already included) -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ775eo8ma2xMl1AzM+eD1f+0Wj6dH/3jH9" crossorigin="anonymous">