@model PetShelter.ViewModels.LocationDetailsVM

@{ ViewBag.Title = "Details"; }

<head>
    <link href="~/css/Details.css" rel="stylesheet" type="text/css" />
</head>

<div class="container">
    <h2 class="text-center">Location Details</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">City:</dt>
                <dd class="col-sm-8">@Model.City</dd>

                <dt class="col-sm-4">Address:</dt>
                <dd class="col-sm-8">@Model.Address</dd>

                <dt class="col-sm-4">Country:</dt>
                <dd class="col-sm-8">@Model.Country</dd>
            </dl>
        </div>
    </div>

    <div class="text-center">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">Edit</a>
        <a href="@Url.Action("List")" class="btn btn-secondary">Back to List</a>
    </div>
</div>