@model IEnumerable<PetShelter.ViewModels.UserDetailsVM>

@{
    ViewBag.Title = "User Management";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text-center mb-4">User Management</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 text-right">
            <!-- Create new user button -->
            @Html.ActionLink("Create New User", "Create", null, new { @class = "btn btn-success mb-3" })
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm">
            <thead class="thead-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Username)
                </th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Username)
                    </td>

                    <td>
                        <!-- Action buttons for Edit, Details, and Delete -->
                        <div class="btn-group" role="group">
                            @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" }) 
                            @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm mx-1" }) 
                            @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>