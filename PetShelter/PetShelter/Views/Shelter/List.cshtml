@model IEnumerable<PetShelter.ViewModels.ShelterDetailsVM>

@{
    ViewBag.Title = "Shelter List";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h2 class="text-center mb-4">Shelters</h2>
            <div class="d-flex justify-content-end mb-3">
                @Html.ActionLink("Create New Shelter", "Create", null, new { @class = "btn btn-primary" })
            </div>

            <table class="table table-bordered table-hover">
                <thead class="thead-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.PetCapacity)</th>
                    <th>@Html.DisplayNameFor(model => model.Pets)</th>
                    <th class="text-center">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.PetCapacity)</td>
                        <td>@Html.DisplayFor(modelItem => item.Pets.Count)</td>
                        <td class="text-center">
                            @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn btn-warning btn-sm" }) 
                            @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm mx-1" }) 
                            @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn btn-danger btn-sm" })
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>