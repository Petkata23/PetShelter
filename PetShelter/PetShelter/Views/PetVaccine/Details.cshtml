@model PetShelter.ViewModels.PetVaccineDetailsVM

@{
    ViewBag.Title = "Details";
}

<div class="container mt-4">
    <h2 class="text-center">Vaccine Type Details</h2>
    <hr />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Vaccine Type Information</h4>
                    <div class="row">
                        <div class="col-sm-4">
                            <strong>Pet:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Html.DisplayFor(model => model.Pet)
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-sm-4">
                            <strong>Vaccine:</strong>
                        </div>
                        <div class="col-sm-8">
                            @Html.DisplayFor(model => model.Vaccine)
                        </div>
                    </div>
                </div>
                <div class="card-footer text-center">
                    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
                    @Html.ActionLink("Back to List", "List", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>
    </div>
</div>