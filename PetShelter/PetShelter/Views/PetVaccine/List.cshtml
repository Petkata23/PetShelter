@model IEnumerable<PetShelter.ViewModels.PetVaccineDetailsVM>

@{
    ViewBag.Title = "List";
}

<h2>Pet Vaccine</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.PetId)</th>
        <th>@Html.DisplayNameFor(model => model.VaccineId)</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.PetId)</td>
            <td>@Html.DisplayFor(modelItem => item.VaccineId)</td>
        </tr>

        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.Id })
        </td>
    }
    </tbody>
</table>