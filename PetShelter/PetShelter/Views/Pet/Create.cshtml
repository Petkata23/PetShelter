@using PetShelter.Controllers
@using PetShelter.Shared.Extensions
@model PetShelter.ViewModels.PetEditVM

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="mb-3 row">
        <label class="col-md-2 col-form-label">Name</label>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-md-2 col-form-label">Age</label>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Age, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Age, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-md-2 col-form-label">Color</label>
        <div class="col-md-10">
            @Html.EditorFor(model => model.Color, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Color, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-md-2 col-form-label">Pet Type</label>
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.PetTypeId, Model.PetTypeList, "Choose a Pet Type...", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.PetTypeId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-md-2 col-form-label">Shelter</label>
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.ShelterId, Model.ShelterList, "Choose a Shelter...", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.ShelterId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-md-2 col-form-label">Breed</label>
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.BreedId, Model.BreedList, "Choose a Breed...", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.BreedId, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.IsAdopted, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.IsAdopted)
            @Html.ValidationMessageFor(model => model.IsAdopted)
        </div>
    </div>

    <div class="mb-3 row">
        @Html.LabelFor(model => model.IsEuthanized, new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.EditorFor(model => model.IsEuthanized)
            @Html.ValidationMessageFor(model => model.IsEuthanized)
        </div>
    </div>

    <div class="mb-3 row">
        <div class="col-md-10 offset-md-2">
            <input type="submit" value="Create" class="btn btn-default" />
        </div>
    </div>
}

<div class="mb-3 row">
    <div class="col-md-10 offset-md-2">
        @Html.ActionLink("Back to List", "List")
    </div>
</div>
