@model PetShelter.ViewModels.PetDetailsVM

@{
    ViewBag.Title = "Details";
}

<div class="container">
    <h2 class="text-center">Pet Details</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Name:</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Age:</dt>
                <dd class="col-sm-8">@Model.Age</dd>

                <dt class="col-sm-4">Color:</dt>
                <dd class="col-sm-8">@Model.Color</dd>

                <dt class="col-sm-4">Pet Type:</dt>
                <dd class="col-sm-8">@Model.PetType.Name</dd>

                <dt class="col-sm-4">Breed:</dt>
                <dd class="col-sm-8">@Model.Breed.Name</dd>

                <dt class="col-sm-4">Is Adopted:</dt>
                <dd class="col-sm-8">@Model.IsAdopted</dd>

                <dt class="col-sm-4">Is Euthanized:</dt>
                <dd class="col-sm-8">@Model.IsEuthanized</dd>

            </dl>
        </div>
    </div>

    <div class="text-center">
        <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-primary">Edit</a>
        <a href="@Url.Action("List")" class="btn btn-secondary">Back to List</a>
    </div>
</div>